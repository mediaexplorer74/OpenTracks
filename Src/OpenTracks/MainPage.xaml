<Page
    x:Class="OpenTracksBETA.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenTracksBETA"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >

    <Grid x:Name="LayoutRoot">
        <Grid.Background>
            <ImageBrush ImageSource="Assets/bg1.png" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="Player" AutoPlay="False" Volume="1.0" Visibility="Collapsed" />

        <!-- Pivot control instead of Hub -->
        <Pivot x:Name="MainPivot" Title="OpenTracks">

            <PivotItem Header="Welcome" IsEnabled="True">
                <Grid>
                    <StackPanel Height="400" Width="320" Margin="20,0">
                        <TextBlock Text="➜ Scroll right to get started"
                       FontSize="21"
                       FontWeight="Light"
                       Margin="0,0,0,20" />

                        <TextBlock Text="| My Profile"
                       FontSize="32"
                       Foreground="White"
                       FontWeight="Light"
                       Tapped="GoToLibrary_Tapped" />

                        <TextBlock Text="| My Uploads"
                       FontSize="32"
                       Foreground="White"
                       FontWeight="Light"
                       Tapped="GoToUpload_Tapped"
                                   Margin="0,20,0,0"/>

                        <TextBlock Text="| Settings"
                       FontSize="32"
                       Foreground="White"
                       FontWeight="Light"
                       Margin="0,20,0,0"
                       Tapped="GoToSettings_Tapped" />
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="Top 10 Hits" IsEnabled="True">
                <Grid>
                    <!-- Track List (visible only when logged in) -->
                    <ListView x:Name="TopTrackList"
                      ItemsSource="{Binding TopTracks}"
                      Tapped="TopTrackTapped"
                      SelectionChanged="TopTrackSelected"
                      Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,17">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="Gray" 
                                               Margin="12,-6,12,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Sign In Button (visible only when not logged in) -->
                    <Button x:Name="SignInButtonTopHits"
                Content="Sign In"
                Click="SignInButton_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="White"
                FontWeight="Bold"
                FontSize="22"
                Padding="12"
                Width="300"/>
                </Grid>
            </PivotItem>

            <PivotItem Header="All Tracks" IsEnabled="True">
                <Grid>
                    <!-- Track List (visible only when logged in) -->
                    <ListView x:Name="TrackList"
                 ItemsSource="{Binding AllTracks}"
                 SelectionChanged="TrackSelected"
                 Tapped="TrackTapped"
                 Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,17">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="Gray" 
                                               Margin="12,-6,12,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Sign In Button (visible only when not logged in) -->
                    <Button x:Name="SignInButtonAllTracks"
                Content="Sign In"
                Click="SignInButton_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="White"
                FontWeight="Bold"
                FontSize="22"
                Padding="12"
                Width="300"/>
                </Grid>
            </PivotItem>

            <PivotItem Header="About App" IsEnabled="True">
                <ScrollViewer>
                    <TextBlock Margin="16" TextWrapping="Wrap" FontSize="24">
                        <Run Text="App Version: 1.0 RC" /><LineBreak/>
                        <Run Text="*All Music Are Non-Copyrighted" /><LineBreak/>
                        <Run Text="OpenTracks for Windows Phone 7" /><LineBreak/><LineBreak/>
                        <Run Text="Developed by:" /><LineBreak/>
                        <Run Text="ChockingNetDude" /><LineBreak/><LineBreak/>
                        <Run Text="OpenTracks for Windows 10 Mobile" /><LineBreak/><LineBreak/>
                        <Run Text="Developed by:" /><LineBreak/>
                        <Run Text="[M]edia[E]xplorer" /><LineBreak/><LineBreak/>
                    </TextBlock>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <Border x:Name="MiniPlayerBar"
        Grid.Row="1"
        Margin="20,0,20,20"
        Background="#AAFFFFFF"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            Opacity="0.95"
        Tapped="MiniPlayerBar_Tapped"
        Height="80">

            <StackPanel Margin="12,6" Height="36" Width="404">
                <TextBlock x:Name="MiniPlayerTitle"
                   Text="No track playing"
                   FontSize="28"
                   FontWeight="ExtraLight"
                   Foreground="White"
                   TextTrimming="WordEllipsis"
                   Height="40"
                   Width="396" />
            </StackPanel>
        </Border>

        <Grid x:Name="FullScreenPlayer"
      Background="#AA0000"
      Grid.RowSpan="2"
      Visibility="Collapsed"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      RenderTransformOrigin="0.5,0.5">


            <!-- Required for slide animation -->
            <Grid.RenderTransform>
                <TranslateTransform Y="0" />
            </Grid.RenderTransform>

            <Grid.Resources>
                <Storyboard x:Name="SlideUpStoryboard">
                    <DoubleAnimation
        Storyboard.TargetName="FullScreenPlayerTransform"
        Storyboard.TargetProperty="Y"
        To="0"
        Duration="0:0:0.3" />
                </Storyboard>

                <Storyboard x:Name="SlideDownStoryboard">
                    <DoubleAnimation
        Storyboard.TargetName="FullScreenPlayerTransform"
        Storyboard.TargetProperty="Y"
        To="480"
        Duration="0:0:0.3" />
                </Storyboard>
            </Grid.Resources>

            <!-- Triangle Minimize Button -->
            <Button x:Name="MinimizeButton"
            Width="75" Height="72"
            Background="#33FFFFFF"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            Foreground="White"
            FontSize="24"
            Content="▼"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16,16,0,0"
            Click="MinimizeButton_Click" />

            <!-- Compact Player Bar -->
            <Border Width="480"
            Height="560"
            Background="#22FFFFFF"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="20">

                <StackPanel>

                    <!-- Track Info -->
                    <TextBlock x:Name="FullPlayerTitle"
                       Text="Track Title"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,10" />

                    <TextBlock x:Name="FullPlayerArtist"
                       Text="Artist Name"
                       FontSize="22"
                       Foreground="#DDDD"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

                    <!-- Progress Bar + Play Button -->
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"
                        Height="60"
                        Width="440"
                        VerticalAlignment="Center">

                        <TextBlock x:Name="FullPlayerElapsed"
                           Text="0:00"
                           FontSize="20"
                           Foreground="White"
                           Width="60"
                           VerticalAlignment="Center" />

                        <Button x:Name="PlayPauseButton"
                        Width="317" Height="71"
                        Background="Transparent"
                        Foreground="White"
                        FontSize="28"
                        Content="▶"
                        Click="PlayPauseButton_Click" />

                        <TextBlock x:Name="FullPlayerDuration"
                           Text="3:45"
                           FontSize="20"
                           Foreground="White"
                           Width="60"
                           VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>