<Page
    x:Class="OpenTracksBETA.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenTracksBETA"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <QuarticEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <QuarticEase x:Key="EaseIn" EasingMode="EaseIn"/>

        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="SlideTransform"
                Storyboard.TargetProperty="X"
                From="-100" To="0"
                Duration="0:0:0.5"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation
                Storyboard.TargetName="MainContent"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.5"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="SlideTransform"
                Storyboard.TargetProperty="X"
                From="0" To="100"
                Duration="0:0:0.4"
                EasingFunction="{StaticResource EaseIn}"/>
            <DoubleAnimation
                Storyboard.TargetName="MainContent"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                Duration="0:0:0.4"
                EasingFunction="{StaticResource EaseIn}"/>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="MainContent"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-100"/>
        </Grid.RenderTransform>

        <StackPanel Margin="24">
            <TextBlock Text="Your Account:"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,24" />

            <Border Background="White" Padding="6" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="Email" FontWeight="Normal" FontSize="18" Foreground="#34495E"/>
                    <TextBlock x:Name="EmailText" FontSize="20" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <Border Background="White" Padding="6" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="User ID" FontWeight="Normal" FontSize="18" Foreground="#34495E"/>
                    <TextBlock x:Name="UserIdText" FontSize="20" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <Border Background="White" Padding="6" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="Device Name" FontWeight="Normal" FontSize="18" Foreground="#34495E"/>
                    <TextBlock x:Name="DeviceNameText" FontSize="20" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <Border Background="White" Padding="6" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="OS Version" FontWeight="Normal" FontSize="18" Foreground="#34495E"/>
                    <TextBlock x:Name="OSVersionText" FontSize="20" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <Border Background="White" Padding="6" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Manufacturer" FontWeight="Normal" FontSize="18" Foreground="#34495E"/>
                    <TextBlock x:Name="ManufacturerText" FontSize="20" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <Button Content="Logout"
                    Click="Logout_Click"
                    Background="#3498DB"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Padding="12"
                    FontSize="20" />
        </StackPanel>
    </Grid>
</Page>